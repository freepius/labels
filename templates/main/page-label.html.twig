{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('label/element/cssInline.html.twig', {label}, with_context = false, sandboxed = true) }}
{% endblock %}

{% block body_class %}container-page{% endblock %}

{% block body %}
    {% set label = include(label.templateName, {label}, with_context = true, sandboxed = true) %}

    <main class="page {{ page.cssClasses }}">
        {% for i in range(1, page.x) %}
            {% for j in range(1, page.y) %}
                {{ label|raw }}
            {% endfor %}
        {% endfor %}
    </main>
{% endblock %}
